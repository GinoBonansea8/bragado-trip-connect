# Copy this file to .env and adjust values as needed.

POSTGRES_DB=bragado_trip_connect
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Used by the backend to build its PostgreSQL connection string.
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Origins allowed to call the GraphQL API (CORS): one per frontend app.
TRAVELER_ORIGIN=http://localhost:3000
COMPANY_ORIGIN=http://localhost:3001
